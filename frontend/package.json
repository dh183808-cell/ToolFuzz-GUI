    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.8.1",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
